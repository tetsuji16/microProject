{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "podx CCPM extension version 1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "enabled", "bufferFraction", "levelingOrder", "onlyWithinAvailableSlack", "allowTaskSplits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enabled": { "type": "boolean" },
    "bufferFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "levelingOrder": { "enum": ["ID_ONLY", "STANDARD", "PRIORITY_STANDARD"] },
    "onlyWithinAvailableSlack": { "type": "boolean" },
    "allowTaskSplits": { "type": "boolean" },
    "baseline": {
      "type": "object",
      "required": ["projectFinishMillis", "projectBufferMillis", "bufferFraction", "criticalTaskIds", "feedingTaskStartMillis", "feedingBufferMillis"],
      "properties": {
        "projectFinishMillis": { "type": "integer", "minimum": 0 },
        "projectBufferMillis": { "type": "integer", "minimum": 0 },
        "bufferFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "criticalTaskIds": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "feedingTaskStartMillis": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "feedingBufferMillis": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
